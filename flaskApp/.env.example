# Copy this file to .env and edit as needed.
# cp flaskApp/.env.example flaskApp/.env

# ---- Default home (takeoff) location ----
HOME_LAT=33.807607
HOME_LON=-84.373981

# ---- Default landing zone ----
LANDING_LAT=33.856192
LANDING_LON=-84.216326

# ---- Simulation ----
# Max concurrent training sessions
MAX_SESSIONS=20

# Telemetry push rate in Hz (1–4 recommended)
TELEMETRY_HZ=2

# ---- Server ----
LOG_LEVEL=INFO
# Change SECRET_KEY to a random string in any shared/production deployment
SECRET_KEY=change-this-in-production
